[Unit]
Description=Advisor call intelligence and event reassessment
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/stockstest
Environment=PYTHONPATH=%h/stockstest
ExecStart=%h/stockstest/.venv/bin/python -m advisor.intelligence.worker
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:%h/stockstest/advisor/logs/intelligence.log
StandardError=append:%h/stockstest/advisor/logs/intelligence.log
