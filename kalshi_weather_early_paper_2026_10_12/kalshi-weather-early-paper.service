[Unit]
Description=Weather early-station PAPER test (public GET only; no orders)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/varma/kalshi_weather_early_paper_2026_10_12
ExecStart=/home/varma/kalshi/venv/bin/python -u /home/varma/kalshi_weather_early_paper_2026_10_12/observer.py
Restart=on-failure
