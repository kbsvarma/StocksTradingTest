# /home/varma/.config/systemd/user/kalshi-crypto-z2-live.service
[Unit]
ConditionPathExists=!/home/varma/MIGRATION_HOLD
Description=Kalshi crypto z2 LIVE (2 contracts; user activation required)
After=network-online.target
Conflicts=kalshi-crypto-z2-observe.service

[Service]
