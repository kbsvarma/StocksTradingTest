[Unit]
Description=Trend bot heartbeat and alert watchdog
ConditionPathExists=/opt/trendbot/current/.venv/bin/python

[Service]
Type=oneshot
User=trendbot
Group=trendbot
WorkingDirectory=/opt/trendbot/current
EnvironmentFile=/etc/trendbot/trendbot.env
ExecStart=/opt/trendbot/current/ops/run_watchdog.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trendbot
