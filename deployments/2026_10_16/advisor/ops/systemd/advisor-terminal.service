[Unit]
Description=Advisor Terminal (read-only research console)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
WorkingDirectory=%h/stockstest
Environment=PYTHONPATH=%h/stockstest
Environment=ADVISOR_ALLOW_UI_REGEN=1
EnvironmentFile=%h/.advisor_terminal_env
EnvironmentFile=-%h/.advisor_research.env
ExecStart=%h/stockstest/.venv/bin/python -m streamlit run advisor/terminal.py --server.port 8505 --server.address 192.168.3.36 --server.headless true --server.enableCORS true --server.enableXsrfProtection true --server.maxUploadSize 1 --browser.gatherUsageStats false --theme.base dark --theme.backgroundColor #0b0e11 --theme.secondaryBackgroundColor #11151a --theme.primaryColor #ff9f0a --theme.textColor #e8e6e3
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/stockstest/advisor/data %h/stockstest/advisor/logs
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
StandardOutput=append:%h/stockstest/advisor/logs/terminal.log
StandardError=append:%h/stockstest/advisor/logs/terminal.log

[Install]
WantedBy=default.target
