[Unit]
Description=Advisor nightly deterministic research build
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/stockstest
Environment=PYTHONPATH=%h/stockstest
ExecStart=%h/stockstest/.venv/bin/python -m advisor.research.nightly
TimeoutStartSec=3600
UMask=0077
NoNewPrivileges=true
StandardOutput=append:%h/stockstest/advisor/logs/research.log
StandardError=append:%h/stockstest/advisor/logs/research.log
